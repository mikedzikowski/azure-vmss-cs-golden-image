{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "CrowdStrike Falcon golden image",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "description": "Build a Windows golden image with the CrowdStrike Falcon sensor pre-installed. Provide your Falcon API Client ID/Secret. A Key Vault is created and seeded with the secrets by the deployment.",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "location": {
                "label": "Region",
                "toolTip": "Region for the gallery, image, Key Vault, and Image Builder template.",
                "resourceTypes": [
                  "Microsoft.Compute/galleries",
                  "Microsoft.VirtualMachineImages/imageTemplates",
                  "Microsoft.KeyVault/vaults"
                ]
              }
            },
            {
              "name": "falconClientId",
              "type": "Microsoft.Common.TextBox",
              "label": "CrowdStrike API Client ID",
              "toolTip": "Falcon OAuth2 API client id. Needs Sensor Download (read) and Sensor Update Policies (read) scopes.",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[0-9a-fA-F]{32}$",
                    "message": "Client ID is a 32-character hexadecimal string."
                  }
                ]
              },
              "visible": true
            },
            {
              "name": "falconClientSecret",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "CrowdStrike API Client Secret",
                "confirmPassword": "Confirm Client Secret"
              },
              "toolTip": "Falcon OAuth2 API client secret. Stored as a secret in the Key Vault created by this deployment.",
              "constraints": {
                "required": true,
                "regex": "^[a-zA-Z0-9]{32,}$",
                "validationMessage": "Enter the API client secret (letters and numbers, 32+ characters)."
              },
              "options": {
                "hideConfirmation": true
              },
              "visible": true
            },
            {
              "name": "sensorUpdatePolicyName",
              "type": "Microsoft.Common.TextBox",
              "label": "Sensor Update Policy name",
              "defaultValue": "platform_default",
              "toolTip": "Windows Sensor Update Policy that determines which sensor version to install. Must resolve to a version currently available in the download catalog. If 'platform_default' points to an aged-out version in your tenant, enter a policy that targets a current version (the build fails at 'Unable to fetch installer details' otherwise).",
              "constraints": {
                "required": true,
                "validations": [
                  { "regex": "^.{1,200}$", "message": "Enter a sensor update policy name." }
                ]
              },
              "visible": true
            }
          ]
        },
        {
          "name": "sourceImage",
          "label": "Source image",
          "elements": [
            {
              "name": "sourceImageInfo",
              "type": "Microsoft.Common.InfoBox",
              "visible": true,
              "options": {
                "icon": "Info",
                "text": "Choose a validated Windows Server (Gen2 / Trusted Launch, x64) image, then a version. These are confirmed to build with this solution. Defaults to Windows Server 2022 Datacenter."
              }
            },
            {
              "name": "image",
              "type": "Microsoft.Common.DropDown",
              "label": "Windows image",
              "defaultValue": "Windows Server 2022 Datacenter (Gen2)",
              "filter": true,
              "toolTip": "Curated Gen2 / Trusted Launch capable, x64 Windows Server images validated to build with this solution. (Encoded as publisher|offer|sku|definitionName.)",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Windows Server 2025 Datacenter (Gen2)", "value": "MicrosoftWindowsServer|WindowsServer|2025-datacenter-g2|CrowdStrike-Windows-2025" },
                  { "label": "Windows Server 2022 Datacenter (Gen2)", "value": "MicrosoftWindowsServer|WindowsServer|2022-datacenter-g2|CrowdStrike-Windows-2022" },
                  { "label": "Windows Server 2019 Datacenter (Gen2)", "value": "MicrosoftWindowsServer|WindowsServer|2019-datacenter-gensecond|CrowdStrike-Windows-2019" },
                  { "label": "Windows Server 2016 Datacenter (Gen2)", "value": "MicrosoftWindowsServer|WindowsServer|2016-datacenter-gensecond|CrowdStrike-Windows-2016" }
                ]
              },
              "visible": true
            },
            {
              "name": "versionsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat(steps('basics').resourceScope.subscription.id, '/providers/Microsoft.Compute/locations/', steps('basics').resourceScope.location.name, '/publishers/', first(split(steps('sourceImage').image, '|')), '/artifacttypes/vmimage/offers/', first(skip(split(steps('sourceImage').image, '|'), 1)), '/skus/', first(skip(split(steps('sourceImage').image, '|'), 2)), '/versions?api-version=2023-07-01')]"
              }
            },
            {
              "name": "sourceImageVersion",
              "type": "Microsoft.Common.DropDown",
              "label": "Version",
              "defaultValue": "[last(map(steps('sourceImage').versionsApi, (item) => item.name))]",
              "filter": true,
              "toolTip": "Source image version for the selected image (pulled live from Azure). Defaults to newest.",
              "constraints": {
                "required": true,
                "allowedValues": "[map(steps('sourceImage').versionsApi, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
              },
              "visible": true
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ResourceGroup",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]",
      "location": "[steps('basics').resourceScope.location.name]",
      "parameters": {
        "location": "[steps('basics').resourceScope.location.name]",
        "falconClientId": "[steps('basics').falconClientId]",
        "falconClientSecret": "[steps('basics').falconClientSecret.password]",
        "sensorUpdatePolicyName": "[steps('basics').sensorUpdatePolicyName]",
        "sourceImagePublisher": "[first(split(steps('sourceImage').image, '|'))]",
        "sourceImageOffer": "[first(skip(split(steps('sourceImage').image, '|'), 1))]",
        "sourceImageSku": "[first(skip(split(steps('sourceImage').image, '|'), 2))]",
        "sourceImageVersion": "[steps('sourceImage').sourceImageVersion]",
        "imageDefinitionName": "[last(split(steps('sourceImage').image, '|'))]"
      }
    }
  }
}
