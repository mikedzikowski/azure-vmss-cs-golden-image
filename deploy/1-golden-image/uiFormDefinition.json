{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "CrowdStrike Falcon golden image",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "description": "Build a Windows golden image with the CrowdStrike Falcon sensor pre-installed. Provide your Falcon API Client ID/Secret. A Key Vault is created and seeded with the secrets by the deployment.",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "location": {
                "label": "Region",
                "toolTip": "Region for the gallery, image, Key Vault, and Image Builder template.",
                "resourceTypes": [
                  "Microsoft.Compute/galleries",
                  "Microsoft.VirtualMachineImages/imageTemplates",
                  "Microsoft.KeyVault/vaults"
                ]
              }
            },
            {
              "name": "falconClientId",
              "type": "Microsoft.Common.TextBox",
              "label": "CrowdStrike API Client ID",
              "toolTip": "Falcon OAuth2 API client id. Needs Sensor Download (read) and Sensor Update Policies (read) scopes.",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[0-9a-fA-F]{32}$",
                    "message": "Client ID is a 32-character hexadecimal string."
                  }
                ]
              },
              "visible": true
            },
            {
              "name": "falconClientSecret",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "CrowdStrike API Client Secret",
                "confirmPassword": "Confirm Client Secret"
              },
              "toolTip": "Falcon OAuth2 API client secret. Stored as a secret in the Key Vault created by this deployment.",
              "constraints": {
                "required": true,
                "regex": "^[a-zA-Z0-9]{32,}$",
                "validationMessage": "Enter the API client secret (letters and numbers, 32+ characters)."
              },
              "options": {
                "hideConfirmation": true
              },
              "visible": true
            }
          ]
        },
        {
          "name": "sourceImage",
          "label": "Source image",
          "elements": [
            {
              "name": "sourceImageInfo",
              "type": "Microsoft.Common.InfoBox",
              "visible": true,
              "options": {
                "icon": "Info",
                "text": "The base Windows image the golden image is built from. It must be a Gen2 / Trusted Launch capable SKU. Defaults target Windows Server 2022 Datacenter (Gen2)."
              }
            },
            {
              "name": "sourceImagePublisher",
              "type": "Microsoft.Common.DropDown",
              "label": "Publisher",
              "defaultValue": "MicrosoftWindowsServer",
              "toolTip": "Image publisher. Curated to the common Windows publishers (there are ~2,600 publishers in Azure, so a full list is impractical).",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "MicrosoftWindowsServer", "value": "MicrosoftWindowsServer" },
                  { "label": "microsoftwindowsdesktop", "value": "microsoftwindowsdesktop" },
                  { "label": "MicrosoftSQLServer", "value": "MicrosoftSQLServer" }
                ]
              },
              "visible": true
            },
            {
              "name": "offersApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat(subscription().id, '/providers/Microsoft.Compute/locations/', steps('basics').resourceScope.location.name, '/publishers/', steps('sourceImage').sourceImagePublisher, '/artifacttypes/vmimage/offers?api-version=2023-07-01')]"
              }
            },
            {
              "name": "sourceImageOffer",
              "type": "Microsoft.Common.DropDown",
              "label": "Offer",
              "toolTip": "Image offer for the selected publisher (pulled live from Azure).",
              "constraints": {
                "required": true,
                "allowedValues": "[map(steps('sourceImage').offersApi, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
              },
              "visible": true
            },
            {
              "name": "skusApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat(subscription().id, '/providers/Microsoft.Compute/locations/', steps('basics').resourceScope.location.name, '/publishers/', steps('sourceImage').sourceImagePublisher, '/artifacttypes/vmimage/offers/', steps('sourceImage').sourceImageOffer, '/skus?api-version=2023-07-01')]"
              }
            },
            {
              "name": "sourceImageSku",
              "type": "Microsoft.Common.DropDown",
              "label": "SKU",
              "toolTip": "Image SKU (pulled live from Azure). Pick a Gen2 / Trusted Launch capable SKU (typically ends in -g2).",
              "constraints": {
                "required": true,
                "allowedValues": "[map(steps('sourceImage').skusApi, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
              },
              "visible": true
            },
            {
              "name": "versionsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat(subscription().id, '/providers/Microsoft.Compute/locations/', steps('basics').resourceScope.location.name, '/publishers/', steps('sourceImage').sourceImagePublisher, '/artifacttypes/vmimage/offers/', steps('sourceImage').sourceImageOffer, '/skus/', steps('sourceImage').sourceImageSku, '/versions?api-version=2023-07-01')]"
              }
            },
            {
              "name": "sourceImageVersion",
              "type": "Microsoft.Common.DropDown",
              "label": "Version",
              "toolTip": "Source image version (pulled live from Azure). Pick the newest for a fully patched base.",
              "constraints": {
                "required": true,
                "allowedValues": "[map(steps('sourceImage').versionsApi, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
              },
              "visible": true
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ResourceGroup",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]",
      "location": "[steps('basics').resourceScope.location.name]",
      "parameters": {
        "location": "[steps('basics').resourceScope.location.name]",
        "falconClientId": "[steps('basics').falconClientId]",
        "falconClientSecret": "[steps('basics').falconClientSecret.password]",
        "sourceImagePublisher": "[steps('sourceImage').sourceImagePublisher]",
        "sourceImageOffer": "[steps('sourceImage').sourceImageOffer]",
        "sourceImageSku": "[steps('sourceImage').sourceImageSku]",
        "sourceImageVersion": "[steps('sourceImage').sourceImageVersion]"
      }
    }
  }
}
