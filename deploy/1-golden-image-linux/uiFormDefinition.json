{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "CrowdStrike Falcon golden image (Linux)",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "description": "Build a Linux golden image with the CrowdStrike Falcon sensor pre-installed. Provide your Falcon API Client ID/Secret. A Key Vault is created and seeded with the secrets by the deployment. The sensor is installed with PREP_GOLDEN_IMAGE so the AID is stripped for cloning.",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "location": {
                "label": "Region",
                "toolTip": "Region for the gallery, image, Key Vault, and Image Builder template.",
                "resourceTypes": [
                  "Microsoft.Compute/galleries",
                  "Microsoft.VirtualMachineImages/imageTemplates",
                  "Microsoft.KeyVault/vaults"
                ]
              }
            },
            {
              "name": "falconClientId",
              "type": "Microsoft.Common.TextBox",
              "label": "CrowdStrike API Client ID",
              "toolTip": "Falcon OAuth2 API client id. Needs Sensor Download (read) and Sensor Update Policies (read) scopes.",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^[0-9a-fA-F]{32}$",
                    "message": "Client ID is a 32-character hexadecimal string."
                  }
                ]
              },
              "visible": true
            },
            {
              "name": "falconClientSecret",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "CrowdStrike API Client Secret",
                "confirmPassword": "Confirm Client Secret"
              },
              "toolTip": "Falcon OAuth2 API client secret. Stored as a secret in the Key Vault created by this deployment.",
              "constraints": {
                "required": true,
                "regex": "^[a-zA-Z0-9]{32,}$",
                "validationMessage": "Enter the API client secret (letters and numbers, 32+ characters)."
              },
              "options": {
                "hideConfirmation": true
              },
              "visible": true
            },
            {
              "name": "sensorUpdatePolicyName",
              "type": "Microsoft.Common.TextBox",
              "label": "Sensor Update Policy name (optional)",
              "defaultValue": "",
              "toolTip": "Optional Linux Sensor Update Policy that determines which sensor version to install. Leave empty to install the latest available version. If you set a policy, it must resolve to a version currently available in the download catalog.",
              "constraints": {
                "required": false,
                "validations": [
                  { "regex": "^.{0,200}$", "message": "Enter a sensor update policy name (or leave empty)." }
                ]
              },
              "visible": true
            }
          ]
        },
        {
          "name": "sourceImage",
          "label": "Source image",
          "elements": [
            {
              "name": "sourceImageInfo",
              "type": "Microsoft.Common.InfoBox",
              "visible": true,
              "options": {
                "icon": "Info",
                "text": "Choose a validated Gen2 / Trusted Launch, x64 base image, then a version. These publisher/offer/SKU combinations are confirmed to build with this solution. Defaults to Ubuntu Server 22.04 LTS."
              }
            },
            {
              "name": "image",
              "type": "Microsoft.Common.DropDown",
              "label": "Linux image",
              "defaultValue": "Ubuntu Server 22.04 LTS (Gen2)",
              "filter": true,
              "toolTip": "Curated Gen2 / Trusted Launch capable, x64 base images validated to build with this solution. (Encoded as publisher|offer|sku.)",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Ubuntu Server 22.04 LTS (Gen2)", "value": "Canonical|0001-com-ubuntu-server-jammy|22_04-lts-gen2" },
                  { "label": "Ubuntu Server 24.04 LTS (Gen2)", "value": "Canonical|ubuntu-24_04-lts|server" },
                  { "label": "Red Hat Enterprise Linux 9 (Gen2)", "value": "RedHat|RHEL|9-lvm-gen2" },
                  { "label": "Red Hat Enterprise Linux 8 (Gen2)", "value": "RedHat|RHEL|8-lvm-gen2" },
                  { "label": "Debian 12 (Gen2)", "value": "Debian|debian-12|12-gen2" }
                ]
              },
              "visible": true
            },
            {
              "name": "versionsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "[concat(steps('basics').resourceScope.subscription.id, '/providers/Microsoft.Compute/locations/', steps('basics').resourceScope.location.name, '/publishers/', first(split(steps('sourceImage').image, '|')), '/artifacttypes/vmimage/offers/', first(skip(split(steps('sourceImage').image, '|'), 1)), '/skus/', last(split(steps('sourceImage').image, '|')), '/versions?api-version=2023-07-01')]"
              }
            },
            {
              "name": "sourceImageVersion",
              "type": "Microsoft.Common.DropDown",
              "label": "Version",
              "defaultValue": "[last(map(steps('sourceImage').versionsApi, (item) => item.name))]",
              "filter": true,
              "toolTip": "Source image version for the selected SKU (pulled live from Azure). Pick a concrete version to pin the build.",
              "constraints": {
                "required": true,
                "allowedValues": "[map(steps('sourceImage').versionsApi, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
              },
              "visible": true
            },
            {
              "name": "imageDefinitionName",
              "type": "Microsoft.Common.TextBox",
              "label": "Image definition name",
              "defaultValue": "CrowdStrike-Ubuntu-2204",
              "toolTip": "Name for the gallery image definition created for this build. Pass the same value to Step 2. Rename to match your distro/version (e.g. CrowdStrike-RHEL-9).",
              "constraints": {
                "required": true,
                "validations": [
                  { "regex": "^[^\\s]{2,80}$", "message": "Enter an image definition name (no spaces)." }
                ]
              },
              "visible": true
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ResourceGroup",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]",
      "location": "[steps('basics').resourceScope.location.name]",
      "parameters": {
        "location": "[steps('basics').resourceScope.location.name]",
        "falconClientId": "[steps('basics').falconClientId]",
        "falconClientSecret": "[steps('basics').falconClientSecret.password]",
        "sensorUpdatePolicyName": "[steps('basics').sensorUpdatePolicyName]",
        "sourceImagePublisher": "[first(split(steps('sourceImage').image, '|'))]",
        "sourceImageOffer": "[first(skip(split(steps('sourceImage').image, '|'), 1))]",
        "sourceImageSku": "[last(split(steps('sourceImage').image, '|'))]",
        "sourceImageVersion": "[steps('sourceImage').sourceImageVersion]",
        "imageDefinitionName": "[steps('sourceImage').imageDefinitionName]"
      }
    }
  }
}
