{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": true,
      "basics": {
        "description": "Build a **Linux golden image** with the CrowdStrike Falcon sensor pre-installed (Azure Image Builder + Compute Gallery). Provide your Falcon **API Client ID/Secret** and the **source image** to build from. Secrets are stored in a Key Vault created by the deployment. The sensor is installed with PREP_GOLDEN_IMAGE so the AID is stripped for cloning.",
        "location": {
          "label": "Region",
          "toolTip": "Region for the gallery, image, Key Vault, and Image Builder template.",
          "resourceTypes": [
            "Microsoft.Compute/galleries",
            "Microsoft.VirtualMachineImages/imageTemplates",
            "Microsoft.KeyVault/vaults"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "falconClientId",
        "type": "Microsoft.Common.TextBox",
        "label": "CrowdStrike API Client ID",
        "toolTip": "Falcon OAuth2 API client id. The client needs Sensor Download (read) and Sensor Update Policies (read) scopes.",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[0-9a-fA-F]{32}$",
              "message": "Client ID is a 32-character hexadecimal string."
            }
          ]
        },
        "visible": true
      },
      {
        "name": "falconClientSecret",
        "type": "Microsoft.Common.PasswordBox",
        "label": {
          "password": "CrowdStrike API Client Secret",
          "confirmPassword": "Confirm Client Secret"
        },
        "toolTip": "Falcon OAuth2 API client secret. Stored as a secret in the Key Vault created by this deployment.",
        "constraints": {
          "required": true,
          "regex": "^[a-zA-Z0-9]{32,}$",
          "validationMessage": "Enter the API client secret (letters and numbers, 32+ characters)."
        },
        "options": {
          "hideConfirmation": true
        },
        "visible": true
      },
      {
        "name": "sensorUpdatePolicyName",
        "type": "Microsoft.Common.TextBox",
        "label": "Sensor Update Policy name (optional)",
        "defaultValue": "",
        "toolTip": "Optional Linux Sensor Update Policy that determines the sensor version. Leave empty to install the latest available version.",
        "constraints": {
          "required": false,
          "validations": [
            {
              "regex": "^.{0,200}$",
              "message": "Enter a sensor update policy name (or leave empty)."
            }
          ]
        },
        "visible": true
      }
    ],
    "steps": [
      {
        "name": "sourceImage",
        "label": "Source image",
        "elements": [
          {
            "name": "sourceImageInfo",
            "type": "Microsoft.Common.InfoBox",
            "visible": true,
            "options": {
              "icon": "Info",
              "text": "Choose a validated Gen2 / Trusted Launch, x64 base image, then a version. These publisher/offer/SKU combinations are confirmed to build with this solution. Defaults to Ubuntu Server 22.04 LTS."
            }
          },
          {
            "name": "image",
            "type": "Microsoft.Common.DropDown",
            "label": "Linux image",
            "defaultValue": "Ubuntu Server 22.04 LTS (Gen2)",
            "filter": true,
            "toolTip": "Curated Gen2 / Trusted Launch capable, x64 base images validated to build with this solution. (Encoded as publisher|offer|sku|definitionName.)",
            "constraints": {
              "required": true,
              "allowedValues": [
                { "label": "Ubuntu Server 22.04 LTS (Gen2)", "value": "Canonical|0001-com-ubuntu-server-jammy|22_04-lts-gen2|CrowdStrike-Ubuntu-2204" },
                { "label": "Ubuntu Server 24.04 LTS (Gen2)", "value": "Canonical|ubuntu-24_04-lts|server|CrowdStrike-Ubuntu-2404" },
                { "label": "Red Hat Enterprise Linux 9 (Gen2)", "value": "RedHat|RHEL|9-lvm-gen2|CrowdStrike-RHEL-9" },
                { "label": "Red Hat Enterprise Linux 8 (Gen2)", "value": "RedHat|RHEL|8-lvm-gen2|CrowdStrike-RHEL-8" },
                { "label": "Debian 12 (Gen2)", "value": "Debian|debian-12|12-gen2|CrowdStrike-Debian-12" }
              ]
            },
            "visible": true
          },
          {
            "name": "versionsApi",
            "type": "Microsoft.Solutions.ArmApiControl",
            "request": {
              "method": "GET",
              "path": "[concat(subscription().id, '/providers/Microsoft.Compute/locations/', location(), '/publishers/', first(split(steps('sourceImage').image, '|')), '/artifacttypes/vmimage/offers/', first(skip(split(steps('sourceImage').image, '|'), 1)), '/skus/', first(skip(split(steps('sourceImage').image, '|'), 2)), '/versions?api-version=2023-07-01')]"
            }
          },
          {
            "name": "sourceImageVersion",
            "type": "Microsoft.Common.DropDown",
            "label": "Version",
            "defaultValue": "[last(map(steps('sourceImage').versionsApi, (item) => item.name))]",
            "filter": true,
            "toolTip": "Source image version for the selected image (pulled live from Azure). Defaults to newest.",
            "constraints": {
              "required": true,
              "allowedValues": "[map(steps('sourceImage').versionsApi, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
            },
            "visible": true
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "falconClientId": "[basics('falconClientId')]",
      "falconClientSecret": "[basics('falconClientSecret').password]",
      "sourceImagePublisher": "[first(split(steps('sourceImage').image, '|'))]",
      "sourceImageOffer": "[first(skip(split(steps('sourceImage').image, '|'), 1))]",
      "sourceImageSku": "[first(skip(split(steps('sourceImage').image, '|'), 2))]",
      "sourceImageVersion": "[steps('sourceImage').sourceImageVersion]",
      "sensorUpdatePolicyName": "[basics('sensorUpdatePolicyName')]",
      "imageDefinitionName": "[last(split(steps('sourceImage').image, '|'))]"
    }
  }
}
