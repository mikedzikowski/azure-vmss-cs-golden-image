  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ],
      "metadata": {
        "description": "Environment name used in resource naming."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "crowdstrike",
      "metadata": {
        "description": "Project/workload name used in resource naming."
      }
    },
    "keyVaultName": {
      "type": "string",
      "defaultValue": "[take(format('kvcsl{0}', uniqueString(resourceGroup().id)), 24)]",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Key Vault name to create (3-24 chars, start with a letter, alphanumeric/hyphen). Must be globally unique."
      }
    },
    "falconClientId": {
      "type": "securestring",
      "metadata": {
        "description": "CrowdStrike Falcon OAuth2 API Client ID. Needs Sensor Download (read) + Sensor Update Policies (read)."
      }
    },
    "falconClientSecret": {
      "type": "securestring",
      "metadata": {
        "description": "CrowdStrike Falcon OAuth2 API Client Secret."
      }
    },
    "falconCloud": {
      "type": "string",
      "defaultValue": "us-1",
      "allowedValues": [
        "us-1",
        "us-2",
        "eu-1",
        "us-gov-1"
      ],
      "metadata": {
        "description": "CrowdStrike Falcon cloud region."
      }
    },
    "falconCid": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: explicit CrowdStrike Customer ID (CID) with checksum. Leave empty to have the build determine the CID automatically from the Falcon API."
      }
    },
    "sensorUpdatePolicyName": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: Linux Sensor Update Policy name that resolves the sensor version. Leave empty to install the latest available version."
      }
    },
    "provToken": {
      "type": "securestring",
      "defaultValue": "",
      "metadata": {
        "description": "Optional: CrowdStrike provisioning token."
      }
    },
    "galleryName": {
      "type": "string",
      "defaultValue": "[format('{0}_{1}_linux_{2}', parameters('projectName'), parameters('environment'), uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Azure Compute Gallery name (alphanumeric/underscore). Defaults to a name made unique per resource group, since gallery names must be unique in the subscription."
      }
    },
    "imageDefinitionName": {
      "type": "string",
      "defaultValue": "CrowdStrike-Ubuntu-2204",
      "metadata": {
        "description": "Image definition name."
      }
    },
    "imageVersion": {
      "type": "string",
      "defaultValue": "1.0.0",
      "metadata": {
        "description": "Semantic image version to build, e.g. 1.0.0."
      }
    },
    "sourceImagePublisher": {
      "type": "string",
      "defaultValue": "Canonical",
      "metadata": {
        "description": "Source image publisher (Linux, Gen2 / Trusted Launch capable)."
      }
    },
    "sourceImageOffer": {
      "type": "string",
      "defaultValue": "0001-com-ubuntu-server-jammy",
      "metadata": {
        "description": "Source image offer."
      }
    },
    "sourceImageSku": {
      "type": "string",
      "defaultValue": "22_04-lts-gen2",
      "metadata": {
        "description": "Source image SKU (Gen2 / Trusted Launch capable)."
      }
    },
    "sourceImageVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Source image version."
      }
    }
  },
