{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json#",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "CrowdStrike Falcon VMSS (Linux)",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "description": "Deploy a Flexible-orchestration Linux VMSS from the golden image built in Step 1. Each instance registers its own unique AID on first boot.",
          "elements": [
            {
              "name": "resourceScope",
              "type": "Microsoft.Common.ResourceScope",
              "location": {
                "label": "Region",
                "toolTip": "Region for the VMSS and networking.",
                "resourceTypes": [
                  "Microsoft.Compute/virtualMachineScaleSets",
                  "Microsoft.Network/virtualNetworks"
                ]
              }
            },
            {
              "name": "adminUsername",
              "type": "Microsoft.Common.TextBox",
              "label": "Admin username",
              "defaultValue": "azureuser",
              "toolTip": "Local administrator username for the Linux instances.",
              "constraints": {
                "required": true,
                "validations": [
                  { "regex": "^[a-z_][a-z0-9_-]{2,31}$", "message": "3-32 chars, lowercase letters/digits/_/-, must not start with a digit. Avoid reserved names like root/admin." }
                ]
              },
              "visible": true
            },
            {
              "name": "adminPassword",
              "type": "Microsoft.Common.PasswordBox",
              "label": {
                "password": "Admin password",
                "confirmPassword": "Confirm password"
              },
              "toolTip": "Local administrator password. Azure Linux requires 6-72 chars with at least 3 of: lowercase, uppercase, digit, special character.",
              "constraints": {
                "required": true,
                "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d).{12,72}$",
                "validationMessage": "12-72 chars with at least one lowercase, one uppercase, and one digit."
              },
              "options": {
                "hideConfirmation": false
              },
              "visible": true
            }
          ]
        },
        {
          "name": "vmssConfig",
          "label": "VMSS configuration",
          "elements": [
            {
              "name": "galleryImage",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Golden image",
              "toolTip": "Select the CrowdStrike golden image definition built in Step 1 (any Compute Gallery / resource group you can read).",
              "resourceType": "Microsoft.Compute/galleries/images",
              "constraints": {
                "required": true
              },
              "visible": true
            },
            {
              "name": "versionsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('vmssConfig').galleryImage))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('vmssConfig').galleryImage.id, '/versions?api-version=2023-07-03')]"
              }
            },
            {
              "name": "imageVersion",
              "type": "Microsoft.Common.DropDown",
              "label": "Image version",
              "defaultValue": "[last(map(steps('vmssConfig').versionsApi.value, (item) => item.name))]",
              "filter": true,
              "toolTip": "Golden image version (pulled live from the selected image). Defaults to newest.",
              "constraints": {
                "required": true,
                "allowedValues": "[map(steps('vmssConfig').versionsApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
              },
              "visible": "[not(empty(steps('vmssConfig').galleryImage))]"
            },
            {
              "name": "instanceCount",
              "type": "Microsoft.Common.Slider",
              "label": "Instance count",
              "min": 1,
              "max": 100,
              "defaultValue": 2,
              "showStepMarkers": false,
              "toolTip": "Number of VM instances in the scale set.",
              "constraints": {
                "required": true
              },
              "visible": true
            },
            {
              "name": "vmSize",
              "type": "Microsoft.Compute.SizeSelector",
              "label": "VM size",
              "toolTip": "Size for the scale set instances.",
              "recommendedSizes": [
                "Standard_D2s_v3",
                "Standard_D4s_v3",
                "Standard_D2s_v5"
              ],
              "osPlatform": "Linux",
              "count": "[steps('vmssConfig').instanceCount]",
              "visible": true
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "ResourceGroup",
      "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]",
      "location": "[steps('basics').resourceScope.location.name]",
      "parameters": {
        "location": "[steps('basics').resourceScope.location.name]",
        "adminUsername": "[steps('basics').adminUsername]",
        "adminPassword": "[steps('basics').adminPassword.password]",
        "imageDefinitionId": "[steps('vmssConfig').galleryImage.id]",
        "imageVersion": "[steps('vmssConfig').imageVersion]",
        "vmSku": "[steps('vmssConfig').vmSize]",
        "instanceCount": "[int(steps('vmssConfig').instanceCount)]"
      }
    }
  }
}
