{
  "$schema": "https://schema.management.azure.com/schemas/0.1.2-preview/CreateUIDefinition.MultiVm.json#",
  "handler": "Microsoft.Azure.CreateUIDef",
  "version": "0.1.2-preview",
  "parameters": {
    "config": {
      "isWizard": true,
      "basics": {
        "description": "Deploy a **Flexible-orchestration VMSS** from the CrowdStrike Falcon golden image built in Step 1. The sensor is baked into the image (NO_START=1); each instance auto-starts it and registers a unique AID on first boot. Provide the **local administrator** credentials below.",
        "location": {
          "label": "Region",
          "toolTip": "Region for the VMSS, networking, and load balancer.",
          "resourceTypes": [
            "Microsoft.Compute/virtualMachineScaleSets"
          ]
        }
      }
    },
    "basics": [
      {
        "name": "adminUsername",
        "type": "Microsoft.Common.TextBox",
        "label": "Administrator username",
        "defaultValue": "azureuser",
        "toolTip": "Local administrator username for the VMSS instances.",
        "constraints": {
          "required": true,
          "validations": [
            {
              "regex": "^[a-zA-Z0-9]{1,20}$",
              "message": "1-20 letters or numbers. Avoid reserved names like 'administrator'."
            }
          ]
        },
        "visible": true
      },
      {
        "name": "adminPassword",
        "type": "Microsoft.Common.PasswordBox",
        "label": {
          "password": "Administrator password",
          "confirmPassword": "Confirm password"
        },
        "toolTip": "Local administrator password. Must meet Azure Windows complexity: 12-123 chars incl. lowercase, uppercase, number, and a special character.",
        "constraints": {
          "required": true,
          "regex": "^(?=.*[a-z])(?=.*[A-Z])(?=.*\\d)(?=.*[^a-zA-Z0-9]).{12,123}$",
          "validationMessage": "12-123 characters, including lowercase, uppercase, a number, and a special character."
        },
        "options": {
          "hideConfirmation": false
        },
        "visible": true
      }
    ],
    "steps": [
      {
        "name": "vmssConfig",
        "label": "VMSS configuration",
        "elements": [
          {
            "name": "galleryImage",
            "type": "Microsoft.Solutions.ResourceSelector",
            "label": "Golden image",
            "toolTip": "Select the CrowdStrike golden image definition built in Step 1 (any Compute Gallery / resource group you can read).",
            "resourceType": "Microsoft.Compute/galleries/images",
            "constraints": {
              "required": true
            },
            "visible": true
          },
          {
            "name": "versionsApi",
            "type": "Microsoft.Solutions.ArmApiControl",
            "condition": "[not(empty(steps('vmssConfig').galleryImage))]",
            "request": {
              "method": "GET",
              "path": "[concat(steps('vmssConfig').galleryImage.id, '/versions?api-version=2023-07-03')]"
            }
          },
          {
            "name": "imageVersion",
            "type": "Microsoft.Common.DropDown",
            "label": "Image version",
            "defaultValue": "[last(map(steps('vmssConfig').versionsApi.value, (item) => item.name))]",
            "filter": true,
            "toolTip": "Golden image version (pulled live from the selected image). Defaults to newest.",
            "constraints": {
              "required": true,
              "allowedValues": "[map(steps('vmssConfig').versionsApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.name, '\"}')))]"
            },
            "visible": "[not(empty(steps('vmssConfig').galleryImage))]"
          },
          {
            "name": "vmSize",
            "type": "Microsoft.Compute.SizeSelector",
            "label": "VM size",
            "toolTip": "Size for the scale set instances.",
            "recommendedSizes": [
              "Standard_D2s_v3",
              "Standard_D4s_v3",
              "Standard_D2s_v5"
            ],
            "osPlatform": "Windows",
            "count": "[steps('vmssConfig').instanceCount]",
            "visible": true
          },
          {
            "name": "instanceCount",
            "type": "Microsoft.Common.Slider",
            "label": "Instance count",
            "min": 1,
            "max": 100,
            "defaultValue": 2,
            "showStepMarkers": false,
            "toolTip": "Number of VM instances in the scale set.",
            "constraints": {
              "required": true
            },
            "visible": true
          }
        ]
      }
    ],
    "outputs": {
      "location": "[location()]",
      "adminUsername": "[basics('adminUsername')]",
      "adminPassword": "[basics('adminPassword').password]",
      "imageDefinitionId": "[steps('vmssConfig').galleryImage.id]",
      "imageVersion": "[steps('vmssConfig').imageVersion]",
      "vmSku": "[steps('vmssConfig').vmSize]",
      "instanceCount": "[int(steps('vmssConfig').instanceCount)]"
    }
  }
}
