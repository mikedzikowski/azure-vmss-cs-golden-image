            "value": "[variables('resourceTags')]"
          },
          "vmSku": {
            "value": "[parameters('vmSku')]"
          },
          "instanceCount": {
            "value": "[parameters('instanceCount')]"
          },
          "adminUsername": {
            "value": "[parameters('adminUsername')]"
          },
          "adminPassword": {
            "value": "[parameters('adminPassword')]"
          },
          "galleryName": {
            "value": "[parameters('galleryName')]"
          },
          "imageDefinitionName": {
