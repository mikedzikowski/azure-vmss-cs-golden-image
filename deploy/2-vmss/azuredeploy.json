            "imageDefinitionName": {
              "type": "string",
              "metadata": {
                "description": "Image definition name"
              }
            },
            "imageVersion": {
              "type": "string",
              "metadata": {
                "description": "Image version (use \"latest\" for most recent)"
              }
            },
            "subnetId": {
              "type": "string",
              "metadata": {
                "description": "Subnet resource ID"
