{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "3618381868241131088"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "environment": {
      "type": "string",
      "defaultValue": "dev",
      "allowedValues": [
        "dev",
        "test",
        "prod"
      ],
      "metadata": {
        "description": "Environment name used in resource naming."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "crowdstrike",
      "metadata": {
        "description": "Project/workload name used in resource naming."
      }
    },
    "vmSku": {
      "type": "string",
      "defaultValue": "Standard_D2s_v3",
      "metadata": {
        "description": "VM size for the scale set."
      }
    },
    "instanceCount": {
      "type": "int",
      "defaultValue": 2,
      "minValue": 1,
      "maxValue": 100,
      "metadata": {
        "description": "Number of VM instances."
      }
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser",
      "metadata": {
        "description": "Local administrator username."
      }
    },
    "adminPassword": {
      "type": "securestring",
      "metadata": {
        "description": "Local administrator password."
      }
    },
    "galleryName": {
      "type": "string",
      "defaultValue": "[format('{0}_{1}_{2}', parameters('projectName'), parameters('environment'), uniqueString(resourceGroup().id))]",
      "metadata": {
        "description": "Azure Compute Gallery name from Step 1. Defaults to the same per-resource-group unique name Step 1 uses (so a same-RG deploy resolves automatically); override with the galleryName from Step 1 outputs for cross-RG."
      }
    },
    "imageDefinitionName": {
      "type": "string",
      "defaultValue": "CrowdStrike-Windows-2022",
      "metadata": {
        "description": "Image definition name from Step 1."
      }
    },
    "imageVersion": {
      "type": "string",
      "defaultValue": "latest",
      "metadata": {
        "description": "Image version to deploy. Use \"latest\" for the newest published version, or an exact version like 1.0.0 / 20348.x.x."
      }
    },
    "keyVaultName": {
      "type": "string",
      "metadata": {
        "description": "Name of the EXISTING Key Vault (grants the VMSS user-assigned identity read access for future use)."
      }
    },
    "vnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.0.0/16",
      "metadata": {
        "description": "Virtual network address prefix."
      }
    },
    "subnetAddressPrefix": {
      "type": "string",
      "defaultValue": "10.0.1.0/24",
      "metadata": {
        "description": "Subnet address prefix."
      }
    },
    "rdpSourceIpRanges": {
      "type": "array",
      "defaultValue": [],
      "metadata": {
        "description": "Optional RDP source IP ranges (CIDR). Leave empty to add no inbound RDP rule."
      }
    }
  },
  "variables": {
    "namePrefix": "[format('{0}-{1}', parameters('projectName'), parameters('environment'))]",
    "resourceTags": {
      "Environment": "[parameters('environment')]",
      "Project": "[parameters('projectName')]",
      "Purpose": "CrowdStrike-Falcon-VMSS",
      "ManagedBy": "Bicep"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "networking-deployment",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "namePrefix": {
            "value": "[variables('namePrefix')]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('resourceTags')]"
          },
          "vnetAddressPrefix": {
            "value": "[parameters('vnetAddressPrefix')]"
          },
          "subnetAddressPrefix": {
            "value": "[parameters('subnetAddressPrefix')]"
          },
          "rdpSourceIpRanges": {
            "value": "[parameters('rdpSourceIpRanges')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "9970415740466004394"
            }
          },
          "parameters": {
            "namePrefix": {
              "type": "string",
              "metadata": {
                "description": "Resource name prefix"
              }
            },
            "location": {
              "type": "string",
              "metadata": {
                "description": "Location for all resources"
              }
            },
            "tags": {
              "type": "object",
              "metadata": {
                "description": "Tags to apply to all resources"
              }
            },
            "vnetAddressPrefix": {
              "type": "string",
              "metadata": {
                "description": "Virtual network address prefix"
              }
            },
            "subnetAddressPrefix": {
              "type": "string",
              "metadata": {
                "description": "Subnet address prefix"
              }
            },
            "rdpSourceIpRanges": {
              "type": "array",
              "metadata": {
