      "type": "string",
      "metadata": {
        "description": "VMSS name."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vmss-deployment'), '2025-04-01').outputs.vmssName.value]"
    },
    "loadBalancerPublicIp": {
      "type": "string",
      "metadata": {
        "description": "Load balancer public IP."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vmss-deployment'), '2025-04-01').outputs.loadBalancerPublicIp.value]"
    }
  }
}