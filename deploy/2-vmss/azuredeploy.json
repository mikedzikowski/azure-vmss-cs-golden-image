            "galleryImageBaseId": "[format('{0}/resourceGroups/{1}/providers/Microsoft.Compute/galleries/{2}/images/{3}', subscription().id, resourceGroup().name, variables('sanitizedGalleryName'), parameters('imageDefinitionName'))]",
            "galleryImageId": "[if(equals(toLower(parameters('imageVersion')), 'latest'), variables('galleryImageBaseId'), format('{0}/versions/{1}', variables('galleryImageBaseId'), parameters('imageVersion')))]",
            "sanitizedGalleryName": "[replace(replace(parameters('galleryName'), '_', ''), '-', '')]",
            "keyVaultSecretsUserRoleId": "4633458b-17de-408a-b874-0445c86b69e6"
          },
