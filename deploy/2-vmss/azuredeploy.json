  "outputs": {
    "vmssId": {
      "type": "string",
      "metadata": {
        "description": "VMSS resource ID."
      },
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'vmss-deployment'), '2025-04-01').outputs.vmssId.value]"
